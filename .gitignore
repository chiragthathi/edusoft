# ─── Dependencies ───────────────────────────────
node_modules/

# ─── Build output ───────────────────────────────
client/dist/
dist-ssr/
*.tsbuildinfo
client/node_modules/.vite/

# ─── Environment & secrets ──────────────────────
# Never commit API keys (SMTP, AI providers, etc.)
.env
.env.*
!.env.example
# Public build-time config only (VITE_* values are bundled into the browser JS)
!client/.env.production
*.local

# ─── Logs ───────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Python (media pipeline scripts) ────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ─── Test / QA artefacts ────────────────────────
coverage/
playwright-report/
test-results/

# ─── Editor & OS ────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# ─── Local Claude Code settings ─────────────────
.claude/settings.local.json

# NOTE — intentionally committed:
#   client/media-src/          original product photography (source of truth)
#   client/public/media/       generated AVIF/WebP (regenerating takes ~8 min + Python/Pillow)
#   server/data/media-manifest.json   required by the API at startup
