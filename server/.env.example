# Server configuration (set these in the Vercel project → Settings → Environment Variables)
NODE_ENV=production
# Extra browser origins allowed to call the API (comma-separated).
# edusoft-three.vercel.app, its previews and edusofthealth.com are allowed by default.
CLIENT_ORIGIN=
# Canonical site URL used in sitemap.xml
SITE_ORIGIN=https://edusofthealth.com
# API requests per IP per 15 minutes
RATE_LIMIT_MAX=300
# SMTP_HOST= SMTP_PORT= SMTP_USER= SMTP_PASS=   (when email forwarding is wired up)
